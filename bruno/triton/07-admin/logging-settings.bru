meta {
  name: Logging settings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v2/logging
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  Current log verbosity and format. POST the same endpoint to change it **at run time**
  (e.g. {"log_verbose_level": 1} to log each request while debugging), no restart.
}
