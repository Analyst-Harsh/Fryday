# Copy to .env (git-ignored) and fill in real values. This file holds
# placeholders only -- never put a real secret here. Later phases add their
# keys (Langfuse, HF token, search API, Fernet key...) to this file.

# Postgres (compose `core` profile)
POSTGRES_USER=fryday
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fryday
POSTGRES_PORT=5432

# Hugging Face (gated model/dataset downloads). Prefer `hf auth login`,
# which stores the token outside the repo; set this only if you need it here.
HF_TOKEN=

# Langfuse Cloud (EU region): tracing. Keys from your project's Settings > API Keys.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=dev
# Send prompt/reply text with traces (dev only; it's user data).
FRYDAY_TRACE_CONTENT=false

# Fryday app (all optional; defaults live in app/src/fryday/config.py)
# FRYDAY_LLM_BASE_URL=http://127.0.0.1:8080/v1
# FRYDAY_LLM_TEMPERATURE=0.7
# FRYDAY_LLM_TIMEOUT_S=30
