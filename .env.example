# Copy to .env (git-ignored) and fill in real values. This file holds
# placeholders only -- never put a real secret here. Later phases add their
# keys (Langfuse, HF token, search API, Fernet key...) to this file.

# Postgres (compose `core` profile)
POSTGRES_USER=fryday
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fryday
POSTGRES_PORT=5432

# Hugging Face (gated model/dataset downloads). Prefer `hf auth login`,
# which stores the token outside the repo; set this only if you need it here.
HF_TOKEN=

# Langfuse Cloud (EU region)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
